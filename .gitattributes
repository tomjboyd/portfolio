# Normalize all text files to LF, in the repo and in the working tree.
# Overrides core.autocrlf so line endings are identical on every machine
# and match Prettier's default endOfLine and the Linux build target.
* text=auto eol=lf

# Binary assets Git must not touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
