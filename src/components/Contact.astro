---
import { person } from "@/data/profile";
import SectionHeader from "@/components/SectionHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import Icon from "@/components/Icon.astro";

type ContactLink = { name: "linkedin" | "github"; href: string; label: string };
const links = (
  [
    person.links.linkedin
      ? {
          name: "linkedin" as const,
          href: person.links.linkedin,
          label: "LinkedIn",
        }
      : undefined,
    person.links.github
      ? { name: "github" as const, href: person.links.github, label: "GitHub" }
      : undefined,
  ] as Array<ContactLink | undefined>
).filter((link): link is ContactLink => link !== undefined);
---

<section id="contact" class="border-t border-border bg-secondary/30">
  <div class="mx-auto max-w-4xl px-5 py-10 sm:px-8 sm:py-14">
    <SectionHeader index="05" eyebrow="Contact" title="Let's talk" />

    <div
      class="reveal grid gap-10 rounded-lg border border-border bg-card p-8 shadow-sm sm:p-10 lg:grid-cols-[1.2fr_1fr]"
    >
      <div>
        <p class="font-display text-2xl font-medium leading-snug sm:text-3xl">
          Open to front-end roles.
        </p>
        <p
          class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground"
        >
          Remote, or hybrid around Milton Keynes and surrounding areas. If
          you're hiring for senior or lead front-end work I'd be glad to hear
          from you.
        </p>
      </div>

      <div class="flex flex-col gap-3 lg:items-end lg:justify-center">
        <a
          href={`mailto:${person.email}`}
          class={buttonVariants({ size: "lg" }) + " w-full sm:w-auto"}
        >
          <Icon name="mail" class="size-4" />
          {person.email}
        </a>

        <div
          class="flex items-center gap-3 font-mono text-sm text-muted-foreground"
        >
          <Icon name="map-pin" class="size-4" />
          {person.location}
        </div>

        {
          links.length > 0 && (
            <div class="mt-1 flex gap-2">
              {links.map((l) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={buttonVariants({ variant: "outline", size: "icon" })}
                  aria-label={l.label}
                >
                  <Icon name={l.name} class="size-4" />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
