---
import {
  projects,
  projectsIntro,
  projectsScope,
  projectsLimitations,
} from "@/data/profile";
import SectionHeader from "@/components/SectionHeader.astro";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Icon from "@/components/Icon.astro";
---

<section id="projects" class="border-y border-border bg-secondary/30">
  <div class="mx-auto max-w-4xl px-5 py-10 sm:px-8 sm:py-14">
    <SectionHeader
      index="03"
      eyebrow="Independent work"
      title="Products I build & run"
    />
    <p class="reveal mb-4 text-base leading-relaxed text-muted-foreground">
      {projectsIntro}
    </p>
    <p class="reveal mb-4 text-base leading-relaxed text-muted-foreground">
      {projectsScope}
    </p>
    <p class="reveal mb-10 text-base leading-relaxed text-muted-foreground">
      {projectsLimitations}
    </p>
    <div class="grid gap-5 md:grid-cols-2">
      {
        projects.map((project) => (
          <Card class="reveal group flex flex-col justify-between transition-colors hover:border-signal/50">
            <CardContent>
              <div class="mb-1 flex items-start justify-between gap-4">
                <h3 class="font-display text-2xl font-semibold tracking-tight">
                  {project.name}
                </h3>
                {project.url ? (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground transition-colors hover:text-signal"
                    aria-label={`Visit ${project.name}`}
                  >
                    <Icon name="arrow-up-right" class="size-5" />
                  </a>
                ) : (
                  <span class="font-mono text-[0.7rem] text-muted-foreground">
                    live
                  </span>
                )}
              </div>
              <p class="text-sm font-medium text-signal">{project.tagline}</p>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                {project.description}
              </p>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </div>
</section>
