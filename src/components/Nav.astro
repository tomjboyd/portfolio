---
import { nav } from "@/data/profile";
---

<header
  class="sticky top-0 z-40 border-b border-border/70 bg-background/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-14 max-w-4xl items-center px-5 sm:px-8"
    aria-label="Primary"
  >
    <ul
      class="flex items-center gap-0.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-md px-2.5 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground sm:px-3"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
