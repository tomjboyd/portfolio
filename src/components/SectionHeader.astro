---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
}
const { index, eyebrow, title } = Astro.props;
---

<div class="reveal mb-8 flex items-end justify-between gap-6">
  <div>
    <p class="eyebrow mb-3 flex items-center gap-2">
      <span class="text-signal">{index}</span>
      <span class="h-px w-6 bg-border"></span>
      {eyebrow}
    </p>
    <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
      {title}
    </h2>
  </div>
</div>
